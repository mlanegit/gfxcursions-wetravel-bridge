{
  "name": "7-Day Installment Reminders",
  "description": "I will query all PaymentInstallment records with status = 'scheduled' and a due_date exactly 7 days from today where reminder_sent_7d is not true. For each one, I will call the sendEmail function with trigger 'payment_reminder' and the installment's booking_id. Then I will mark reminder_sent_7d as true on that installment.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 13 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "7_day_installment_reminders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "send_installment_reminders_7d",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "send_installment_reminders_7d"
  }
}